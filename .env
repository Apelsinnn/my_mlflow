# GENERAL
MY_TIMEZONE=Europe/Moscow

# PostgreSQL
POSTGRES_USER=admin
POSTGRES_PASSWORD=somestrongpassword12! # поменять
POSTGRES_DB=mlflow

# Minio
S3_BUCKET=mlflow
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=somestrongpassword12! # поменять
AWS_DEFAULT_REGION=eu-central-1
AWS_S3_ADDRESSING_STYLE=path

# MLflow
MLFLOW_VERSION=v3.15.0
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_ARTIFACTS_DESTINATION=s3://${S3_BUCKET}
MLFLOW_ADMIN_USER=admin
MLFLOW_ADMIN_PASSWORD=somestrongpassword12! # поменять
MLFLOW_FLASK_SERVER_SECRET_KEY=somestrongsecretkey12! # import secrets; print(secrets.token_hex(32))